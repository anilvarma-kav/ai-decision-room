# The curated demo works with no keys. Set to 1 to enable paid live runs.
ENABLE_LIVE=0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Model IDs use LiteLLM's provider/model notation. Override for your account.
MODEL_OPENAI=openai/gpt-4.1-mini
MODEL_ANTHROPIC=anthropic/claude-sonnet-4-5-20250929
MODEL_GEMINI=gemini/gemini-2.5-flash
MODEL_OLLAMA=ollama_chat/llama3.2
ENABLE_OLLAMA=0
OLLAMA_API_BASE=http://localhost:11434
# Local use by default. Set a token before exposing live mode to a network.
ROOM_API_TOKEN=
DATABASE_PATH=data/decisions.db
